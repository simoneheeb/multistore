APP_NAME=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=127.0.0.1:8000

# Comma-separated list of proxies whose X-Forwarded-For header is trusted.
# Set this to the IP of the Nuxt SSR server (and any CDN/load balancer in
# front of it), otherwise every server-rendered request looks like it comes
# from one address and the per-visitor rate limits throttle the whole site.
# Leave empty to trust nothing; use "*" only behind a proxy you fully control.
TRUSTED_PROXIES=127.0.0.1

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Must be set or every cross-origin request from the frontend will be blocked.
FRONTEND_URLS=http://localhost:3000,http://multistore.test


# Private configure
DEPLOY_SECRET_TOKEN=
OUTSIDE_STORAGE=

# Seeded administrator account (UserDatabaseSeeder). Change before deploying.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=041 000000000
ADMIN_PASSWORD=change-me

# Public site identity used by the SEO module (sitemap.xml / robots.txt).
# Falls back to the first entry of FRONTEND_URLS when empty.
SITE_URL=
SITE_NAME=Multistore


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=server
DB_USERNAME=root
DB_PASSWORD=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=server
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Requests allowed per minute for each limiter (see config/rate_limits.php).
# Raise these for a high-traffic site, lower them to tighten the screws.
RATE_LIMIT_API=120
RATE_LIMIT_PUBLIC_READ=90
RATE_LIMIT_ADMIN_WRITE=30
RATE_LIMIT_UPLOADS=20
RATE_LIMIT_AUTH=5
