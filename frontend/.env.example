# Base URL of the Laravel API, including the /api prefix.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# Canonical public origin of this site. Used for canonical links, OG tags
# and the sitemap/robots proxy routes.
NUXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: internal API URL used for server-side rendering when the API is
# reachable on a different host from inside the network.
NUXT_API_BASE_SERVER=

# What to do when the API cannot be reached:
#   auto   - try the API, fall back to the JSON snapshot in app/fixtures/data
#   always - never call the API; always use the snapshot
#   never  - never use the snapshot; treat a dead API as an error
NUXT_PUBLIC_OFFLINE_FALLBACK=auto
